{
  "$id": "https://schemas.example.org/governed-change-demo/cap-decision.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "PASS"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "domain_gates_may_run": {
            "const": true
          },
          "failed_checks": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "domain_gates_may_run": {
            "const": false
          },
          "failed_checks": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "basis": {
      "additionalProperties": false,
      "properties": {
        "basis_hash": {
          "$ref": "#/definitions/hash"
        },
        "basis_id": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "required": [
        "basis_id",
        "basis_hash"
      ],
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "AUTHORITY_REVOCATION",
            "AUTHORITY_SCOPE",
            "AUTHORITY_TIME",
            "EVIDENCE_PRESENCE",
            "GATE_APPLICABILITY",
            "NO_TOUCH",
            "POLICY_INTEGRITY",
            "SOURCE_BASIS",
            "VERSION_RECOGNITION"
          ]
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reason_codes": {
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "PASS",
            "BLOCK",
            "HOLD:CONTEXT_UPDATE_REQUIRED"
          ]
        }
      },
      "required": [
        "check_id",
        "status",
        "reason_codes",
        "evidence_refs"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "policyReference": {
      "additionalProperties": false,
      "properties": {
        "policy_hash": {
          "$ref": "#/definitions/hash"
        },
        "policy_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "policy_version": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_hash"
      ],
      "type": "object"
    }
  },
  "description": "A public-safe, mechanical CAP decision. It may permit domain-gate evaluation but never repository execution.",
  "properties": {
    "authority_manifest_reference": {
      "additionalProperties": false,
      "properties": {
        "manifest_hash": {
          "$ref": "#/definitions/hash"
        },
        "manifest_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "required_source_basis": {
          "$ref": "#/definitions/basis"
        }
      },
      "required": [
        "manifest_id",
        "manifest_hash",
        "required_source_basis"
      ],
      "type": "object"
    },
    "canonical_hash": {
      "$ref": "#/definitions/hash"
    },
    "cap_contract_version": {
      "const": "governed-repo.cap-decision/v1"
    },
    "cap_decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "cap_policy_version": {
      "minLength": 1,
      "type": "string"
    },
    "change_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$",
      "type": "string"
    },
    "checks": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "AUTHORITY_REVOCATION"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "AUTHORITY_SCOPE"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "AUTHORITY_TIME"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "EVIDENCE_PRESENCE"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "GATE_APPLICABILITY"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "NO_TOUCH"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "POLICY_INTEGRITY"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "SOURCE_BASIS"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "check_id": {
                "const": "VERSION_RECOGNITION"
              }
            },
            "required": [
              "check_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "$ref": "#/definitions/check"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "contract_version": {
      "const": "governed-repo.cap-decision/v1"
    },
    "decision": {
      "enum": [
        "PASS",
        "BLOCK",
        "HOLD:CONTEXT_UPDATE_REQUIRED"
      ]
    },
    "domain_gate_ids": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "claims_gate"
        },
        {
          "const": "path_gate"
        }
      ],
      "type": "array"
    },
    "domain_gates_may_run": {
      "type": "boolean"
    },
    "evaluation_as_of": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?Z$",
      "type": "string"
    },
    "evaluator_version": {
      "const": "governed-repo.cap-adapter/v1.0.0"
    },
    "evidence_basis": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "enum": [
              "AVAILABLE",
              "REFRESHABLE_UNAVAILABLE"
            ]
          },
          "evidence_class": {
            "enum": [
              "SOURCE_OBSERVATION",
              "DIAGNOSTIC_INFERENCE",
              "PREFERENCE",
              "ACTION_EVENT",
              "OUTCOME_MEASUREMENT"
            ]
          },
          "evidence_hash": {
            "$ref": "#/definitions/hash"
          },
          "evidence_id": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "evidence_state": {
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "REFUTED",
              "INCONCLUSIVE",
              "CONFOUNDED"
            ]
          },
          "source_ref": {
            "$ref": "#/definitions/nonEmptyString"
          },
          "summary": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "required": [
          "availability",
          "evidence_id",
          "evidence_class",
          "evidence_state",
          "source_ref",
          "evidence_hash",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "execution_authority": {
      "const": false
    },
    "failed_checks": {
      "items": {
        "enum": [
          "AUTHORITY_REVOCATION",
          "AUTHORITY_SCOPE",
          "AUTHORITY_TIME",
          "EVIDENCE_PRESENCE",
          "GATE_APPLICABILITY",
          "NO_TOUCH",
          "POLICY_INTEGRITY",
          "SOURCE_BASIS",
          "VERSION_RECOGNITION"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "limitations": {
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "next_lawful_move": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "packet_type": {
      "const": "CAP_DECISION"
    },
    "policy_basis": {
      "additionalProperties": false,
      "properties": {
        "cap_policy": {
          "$ref": "#/definitions/policyReference"
        },
        "claims_gate": {
          "$ref": "#/definitions/policyReference"
        },
        "path_gate": {
          "$ref": "#/definitions/policyReference"
        }
      },
      "required": [
        "cap_policy",
        "claims_gate",
        "path_gate"
      ],
      "type": "object"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "shared_change_envelope_hash": {
      "$ref": "#/definitions/hash"
    },
    "source_basis": {
      "$ref": "#/definitions/basis"
    },
    "stage_id": {
      "const": "cap_decision"
    }
  },
  "required": [
    "contract_version",
    "cap_contract_version",
    "packet_type",
    "stage_id",
    "evaluator_version",
    "cap_policy_version",
    "cap_decision_id",
    "canonical_hash",
    "change_id",
    "revision",
    "shared_change_envelope_hash",
    "source_basis",
    "authority_manifest_reference",
    "evaluation_as_of",
    "policy_basis",
    "checks",
    "evidence_basis",
    "decision",
    "reason_codes",
    "failed_checks",
    "limitations",
    "next_lawful_move",
    "domain_gate_ids",
    "domain_gates_may_run",
    "execution_authority"
  ],
  "title": "CAP Decision v1",
  "type": "object"
}
